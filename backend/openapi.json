{
  "openapi": "3.0.3",
  "info": {
    "title": "Booking Dashboard API",
    "version": "0.1.0",
    "description": "Mock backend API for the role based booking dashboard prototype."
  },
  "servers": [
    {
      "url": "http://localhost:5178",
      "description": "Local backend"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Bootstrap"
    },
    {
      "name": "Bookings"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Admin Lookups"
    },
    {
      "name": "Admin Uploads"
    },
    {
      "name": "Users"
    },
    {
      "name": "User Onboarding"
    },
    {
      "name": "Email Templates"
    },
    {
      "name": "Email Delivery"
    },
    {
      "name": "Email Settings"
    }
  ],
  "paths": {
    "/api/admin/email-provider/google/start": {
      "post": {
        "tags": [
          "Email Settings"
        ],
        "summary": "Start Admin Google OAuth connection",
        "responses": {
          "200": {
            "description": "Google authorization URL"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/email-provider/google/callback": {
      "get": {
        "tags": [
          "Email Settings"
        ],
        "summary": "Complete Google OAuth using a single-use state",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Popup completion page"
          },
          "400": {
            "description": "Invalid or expired state"
          }
        }
      }
    },
    "/api/admin/email-provider/google/test": {
      "post": {
        "tags": [
          "Email Settings"
        ],
        "summary": "Send a provider test email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipientEmail"
                ],
                "properties": {
                  "recipientEmail": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Test accepted by Gmail"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/email-provider/google/disconnect": {
      "post": {
        "tags": [
          "Email Settings"
        ],
        "summary": "Revoke and remove the active Google sender authorization",
        "responses": {
          "200": {
            "description": "Sender disconnected"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Backend is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login with account credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Validate the current HttpOnly session",
        "responses": {
          "200": {
            "description": "Current authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/password/forgot": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Request a password reset email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted without revealing account existence"
          }
        }
      }
    },
    "/api/auth/password/reset/validate": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Validate a single-use password reset token",
        "responses": {
          "200": {
            "description": "Token is valid"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/password/reset": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reset password with a valid token",
        "responses": {
          "200": {
            "description": "Password reset and sessions revoked"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/password/change": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change the authenticated user's password",
        "responses": {
          "200": {
            "description": "Password changed and sessions revoked"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/onboarding/single": {
      "post": {
        "tags": [
          "User Onboarding"
        ],
        "summary": "Validate and create one pending user invitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUploadRow"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pending user created and onboarding advanced to template selection"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/bootstrap": {
      "get": {
        "tags": [
          "Bootstrap"
        ],
        "summary": "Load roles, users, lookup values, and regions",
        "responses": {
          "200": {
            "description": "Bootstrap data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "List bookings with role and dashboard filters",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Admin"
          },
          {
            "name": "userId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "u-admin"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "West"
          },
          {
            "name": "wholesaleInput",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "filled",
                "missing"
              ]
            }
          },
          {
            "name": "retailInput",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "filled",
                "missing"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Booking"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{bookingId}": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Get one role-accessible booking",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingId"
          },
          {
            "name": "role",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "booking": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List unread notifications for an active Admin",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "u-admin"
          }
        ],
        "responses": {
          "200": {
            "description": "Unread notification snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "notifications": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "unreadCount": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/notifications/stream": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Stream Admin notification snapshots and updates with SSE",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "u-admin"
          }
        ],
        "responses": {
          "200": {
            "description": "Long-lived text/event-stream connection",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/notifications/{notificationId}/read": {
      "patch": {
        "tags": [
          "Notifications"
        ],
        "summary": "Mark one Admin notification as read",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId"
                ],
                "properties": {
                  "userId": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "userId": "u-admin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification read state saved"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/bookings/{bookingId}/area-inputs": {
      "patch": {
        "tags": [
          "Bookings"
        ],
        "summary": "Save Area Manager workflow inputs",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AreaInputs"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/BookingUpdated"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/bookings/{bookingId}/regional-inputs": {
      "patch": {
        "tags": [
          "Bookings"
        ],
        "summary": "Save Regional Manager workflow inputs",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegionalInputs"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/BookingUpdated"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/lookups/{fieldCode}/options": {
      "post": {
        "tags": [
          "Admin Lookups"
        ],
        "summary": "Add dropdown option for an Area Manager field",
        "parameters": [
          {
            "$ref": "#/components/parameters/FieldCode"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddLookupOptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/LookupUpdated"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/lookups/{fieldCode}/options/{optionId}": {
      "patch": {
        "tags": [
          "Admin Lookups"
        ],
        "summary": "Edit, deactivate, or reactivate a dropdown option",
        "parameters": [
          {
            "$ref": "#/components/parameters/FieldCode"
          },
          {
            "name": "optionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLookupOptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/LookupUpdated"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/bookings/template": {
      "get": {
        "tags": [
          "Admin Uploads"
        ],
        "summary": "Download booking CSV template",
        "responses": {
          "200": {
            "description": "CSV template",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/bookings/import": {
      "post": {
        "tags": [
          "Admin Uploads"
        ],
        "summary": "Import booking CSV content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              },
              "example": {
                "fileName": "booking-upload.csv",
                "content": "Dealer Code,Contact First Name,...\\nDLR001,Ravi,..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UploadResult"
          },
          "422": {
            "$ref": "#/components/responses/UploadResult"
          }
        }
      }
    },
    "/api/admin/bookings/export": {
      "get": {
        "tags": [
          "Admin Uploads"
        ],
        "summary": "Export bookings as Excel-compatible HTML workbook",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Excel-compatible workbook",
            "content": {
              "application/vnd.ms-excel": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/regions": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create an active Region for access management",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Region created"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/dealer-codes": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create an active Dealer Code for an existing Region",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code",
                  "region"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "maxLength": 30
                  },
                  "region": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dealer Code created"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/users/template": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Download user upload CSV template",
        "responses": {
          "200": {
            "description": "CSV template",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create or update a single user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUploadRow"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UploadResult"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/admin/users/import": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Import bulk users from CSV content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UploadResult"
          },
          "422": {
            "$ref": "#/components/responses/UploadResult"
          }
        }
      }
    },
    "/api/admin/users/{userId}": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Update an existing user",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "role",
                  "region",
                  "status"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "role": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "inactive",
                      "locked"
                    ]
                  },
                  "updatedBy": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/activation/validate": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Validate a single-use account activation token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "writeOnly": true
