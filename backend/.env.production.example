NODE_ENV=production
PORT=5178
APP_URL=https://booking.example.com
PERSISTENCE_DRIVER=mysql
DATABASE_URL=
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=100
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
RATE_LIMIT_DRIVER=redis
REDIS_URL=
DATA_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=
MAX_REQUEST_BYTES=2097152
AUDIT_RETENTION_DAYS=365
UPLOAD_RETENTION_DAYS=30
ALLOW_DEMO_CREDENTIALS=false
EMAIL_TRANSPORT=gmail_api
EMAIL_DELIVERY_TIMEOUT_MS=30000
EMAIL_DELIVERY_MAX_ATTEMPTS=3
EMAIL_DELIVERY_BASE_DELAY_MS=250
EMAIL_DELIVERY_MAX_DELAY_MS=5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://booking.example.com/api/admin/email-provider/google/callback
SUPPORT_EMAIL=
