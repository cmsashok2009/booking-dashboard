APP_PORT=3000
APP_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false

MYSQL_PASSWORD=replace-with-a-long-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-value
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-at-least-10-chars-uppercase-lowercase-number
# Keep mock for local UI testing. Use gmail_api after configuring Google OAuth.
EMAIL_TRANSPORT=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/email-provider/google/callback
SUPPORT_EMAIL=
